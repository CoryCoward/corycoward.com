---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contact | Cory Coward"
    description="Contact Cory Coward about software, embedded systems, and interesting problems."
    activeNavigation="contact"
>
    <main class="contact-page">
        <section class="contact-hero" aria-labelledby="contact-title">
            <p class="eyebrow"><span></span> START A CONVERSATION</p>
            <h1 id="contact-title">Get in touch.</h1>
            <p>
                Have a project, a difficult system, or an interesting problem
                to discuss? Send a note and I will get back to you.
            </p>
        </section>

        <section class="contact-form-section" aria-labelledby="contact-form-title">
            <div class="contact-form-intro">
                <p class="eyebrow"><span></span> MESSAGE CHANNEL</p>
                <h2 id="contact-form-title">Tell me what you are building.</h2>
                <p>
                    A little context helps. Include the problem, where things
                    stand, and how I can help.
                </p>
            </div>

            <form
                class="contact-form"
                name="contact"
                method="POST"
                action="/contact/success/"
                aria-labelledby="contact-form-title"
                data-netlify="true"
                netlify-honeypot="bot-field"
            >
                <p class="visually-hidden" aria-hidden="true">
                    <label>
                        Leave this field empty
                        <input
                            name="bot-field"
                            type="text"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </label>
                </p>

                <div class="form-field">
                    <label for="name">Name</label>
                    <input id="name" name="name" type="text" required />
                </div>

                <div class="form-field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" required />
                </div>

                <div class="form-field form-field-message">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="7" required></textarea>
                </div>

                <button class="contact-submit" type="submit">
                    Send message <span aria-hidden="true">&rarr;</span>
                </button>
            </form>
        </section>
    </main>
</BaseLayout>